<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Source Badge -->
    <TextView
        android:id="@+id/tvCallBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="📡 INCOMING CALL VIA HOTSPOT"
        android:textColor="@color/purple_500"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Avatar Placeholder / Ringing Icon -->
    <ImageView
        android:id="@+id/ivCallerAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_card"
        android:padding="28dp"
        android:src="@drawable/ic_launcher_foreground" />

    <!-- Caller Name -->
    <TextView
        android:id="@+id/tvCallerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="John Doe"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Caller Phone Number -->
    <TextView
        android:id="@+id/tvCallerNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="+1 (555) 123-4567"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Transmitter device is currently ringing"
        android:textColor="@color/accent_amber"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Silence / Dismiss Alert -->
        <Button
            android:id="@+id/btnDismissCall"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/card_border"
            android:text="✕ Dismiss Alert / Silence"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
